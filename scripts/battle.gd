						or rc_h.max_resource <= 0:
					continue
				var rc_gain := maxi(int(rc_h.max_resource * 0.01 * u.rallying_cry), 1)
				rc_h.resource = mini(rc_h.resource + rc_gain, rc_h.max_resource)
				rc_h.float_text("+%d %s" % [rc_gain, rc_h.resource_name],
					Color(0.5, 0.8, 1.0))
