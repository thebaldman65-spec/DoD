const SPEC_ART := {
	"berserker": {"sheet_dir": "res://assets/sprites/berserker", "frame_size": 124,
		"sprite_scale": 1.25,
		"portrait_path": "res://assets/sprites/berserker/Berserker_Portrait.png",
