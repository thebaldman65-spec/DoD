				_sfx("death", -4.0)
				_message("%s falls!" % strike_target.unit_name)
				_log("† %s dies" % strike_target.unit_name, "#e05050")
				if strike_target.is_companion:
					_on_beast_death(strike_target)
				elif not strike_target.is_hero:
					_on_enemy_death(strike_target)
