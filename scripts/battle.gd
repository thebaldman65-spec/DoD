					* (1.0 + 0.25 * attacker.blast_radius_ranks)
				for det_t in det_pool:
					var det: Dictionary = det_t.get_status("burn")
					if det.is_empty():
						continue
					var det_left: int = maxi(int(det.turns), 0)
					if det_left <= 0:
						continue
